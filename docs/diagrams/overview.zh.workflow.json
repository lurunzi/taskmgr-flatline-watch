{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "任务管理器轻量异常记录",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "任务管理器"
        },
        "backend": {
          "label": "监测步骤"
        },
        "security": {
          "label": "防护"
        },
        "database": {
          "label": "证据"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "taskmgr",
      "label": "任务管理器"
    },
    {
      "id": "watcher",
      "label": "监测程序（托盘，管理员）"
    },
    {
      "id": "guard",
      "label": "防护",
      "variant": "exception"
    },
    {
      "id": "evidence",
      "label": "D 盘证据"
    }
  ],
  "phases": [
    {
      "id": "observe",
      "label": "观察",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "capture",
      "label": "保存现场",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "label": "恢复及离线分析",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "cpu_page",
    "chart_read",
    "detector",
    "target_check",
    "dumps",
    "restart",
    "analysis"
  ],
  "nodes": [
    {
      "id": "cpu_page",
      "lane": "taskmgr",
      "col": 0,
      "type": "frontend",
      "label": "CPU 页面",
      "sublabel": "逻辑处理器视图",
      "width": 150
    },
    {
      "id": "chart_read",
      "lane": "watcher",
      "col": 1,
      "type": "backend",
      "label": "读取图表",
      "sublabel": "每 2 秒 PrintWindow",
      "width": 150
    },
    {
      "id": "detector",
      "lane": "watcher",
      "col": 2,
      "type": "backend",
      "label": "冻结检测",
      "sublabel": "总图平 30 秒、分线程在动",
      "width": 150
    },
    {
      "id": "target_check",
      "lane": "watcher",
      "col": 3,
      "type": "backend",
      "label": "保存观察",
      "sublabel": "时间与图表",
      "width": 150
    },
    {
      "id": "dumps",
      "lane": "watcher",
      "col": 4,
      "type": "backend",
      "label": "请求保存事件",
      "sublabel": "最多等待两秒",
      "width": 150
    },
    {
      "id": "restart",
      "lane": "taskmgr",
      "col": 5,
      "type": "backend",
      "label": "重启任务管理器",
      "sublabel": "重新打开并回到 CPU 页",
      "width": 150
    },
    {
      "id": "no_capture",
      "lane": "guard",
      "col": 2,
      "type": "security",
      "label": "继续观察",
      "sublabel": "整页静止不触发",
      "width": 150
    },
    {
      "id": "captures",
      "lane": "evidence",
      "col": 4,
      "type": "database",
      "label": "异常证据",
      "sublabel": "ETL、时间、图表",
      "width": 150
    },
    {
      "id": "ring",
      "lane": "evidence",
      "col": 0,
      "type": "database",
      "label": "循环 ETW",
      "sublabel": "进程与线程，64 MiB",
      "width": 150
    },
    {
      "id": "analysis",
      "lane": "evidence",
      "col": 5,
      "type": "backend",
      "label": "离线候选分析",
      "sublabel": "父链、计数、覆盖",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "read",
      "from": "cpu_page",
      "to": "chart_read",
      "label": "原生图表"
    },
    {
      "id": "sample",
      "from": "chart_read",
      "to": "detector"
    },
    {
      "id": "suspect",
      "from": "detector",
      "to": "target_check",
      "label": "疑似冻结",
      "variant": "emphasis"
    },
    {
      "id": "verified",
      "from": "target_check",
      "to": "dumps",
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "from": "dumps",
      "to": "restart",
      "label": "保存失败也恢复",
      "variant": "emphasis"
    },
    {
      "id": "ignore",
      "from": "detector",
      "to": "no_capture",
      "label": "不满足条件",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "write",
      "from": "dumps",
      "to": "captures",
      "label": "异步保存",
      "variant": "dashed"
    },
    {
      "id": "ring_save",
      "from": "ring",
      "to": "captures",
      "label": "原始事件",
      "variant": "dashed"
    },
    {
      "id": "after_recovery",
      "from": "restart",
      "to": "analysis",
      "label": "恢复后",
      "variant": "emphasis"
    },
    {
      "id": "decode",
      "from": "captures",
      "to": "analysis",
      "label": "解码",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "候选，不是因果结论",
      "items": [
        "观察时刻不是底层故障时刻",
        "缺失时段或丢事件时不输出具名排行",
        "不挂调试器，不写转储，保留原始证据"
      ]
    }
  ]
}
