{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Task Manager lightweight incident recording",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "Task Manager"
        },
        "backend": {
          "label": "Watcher step"
        },
        "security": {
          "label": "Guard"
        },
        "database": {
          "label": "Evidence"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "taskmgr",
      "label": "Task Manager"
    },
    {
      "id": "watcher",
      "label": "Watcher (tray, elevated)"
    },
    {
      "id": "guard",
      "label": "Guards",
      "variant": "exception"
    },
    {
      "id": "evidence",
      "label": "Evidence on D:"
    }
  ],
  "phases": [
    {
      "id": "observe",
      "label": "Observe",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "capture",
      "label": "Preserve incident",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "label": "Recover and analyse",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "cpu_page",
    "chart_read",
    "detector",
    "target_check",
    "dumps",
    "restart",
    "analysis"
  ],
  "nodes": [
    {
      "id": "cpu_page",
      "lane": "taskmgr",
      "col": 0,
      "type": "frontend",
      "label": "CPU logical grid",
      "sublabel": "80% widths within 1 px",
      "width": 150
    },
    {
      "id": "chart_read",
      "lane": "watcher",
      "col": 1,
      "type": "backend",
      "label": "Charts + CPU time",
      "sublabel": "read every 2 s",
      "width": 150
    },
    {
      "id": "detector",
      "lane": "watcher",
      "col": 2,
      "type": "backend",
      "label": "Freeze confirmation",
      "sublabel": "native 10 s / visual 30 s",
      "width": 150
    },
    {
      "id": "target_check",
      "lane": "watcher",
      "col": 3,
      "type": "backend",
      "label": "Save observations",
      "sublabel": "times, charts, resets",
      "width": 150
    },
    {
      "id": "dumps",
      "lane": "watcher",
      "col": 4,
      "type": "backend",
      "label": "Save ETW",
      "sublabel": "wait at most 2 s",
      "width": 150
    },
    {
      "id": "restart",
      "lane": "taskmgr",
      "col": 5,
      "type": "backend",
      "label": "Restart / restore CPU",
      "sublabel": "boot launch & A8 backoff",
      "width": 150
    },
    {
      "id": "no_capture",
      "lane": "guard",
      "col": 2,
      "type": "security",
      "label": "Keep observing",
      "sublabel": "static or uncorroborated idle",
      "width": 150
    },
    {
      "id": "captures",
      "lane": "evidence",
      "col": 4,
      "type": "database",
      "label": "Incident evidence",
      "sublabel": "ETL, heartbeat, charts",
      "width": 150
    },
    {
      "id": "ring",
      "lane": "evidence",
      "col": 0,
      "type": "database",
      "label": "Dual circular ETW",
      "sublabel": "Kernel + Taskmgr Error",
      "width": 150
    },
    {
      "id": "analysis",
      "lane": "evidence",
      "col": 5,
      "type": "backend",
      "label": "Native & churn",
      "sublabel": "0x8007139F & heartbeat",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "read",
      "from": "cpu_page",
      "to": "chart_read",
      "label": "native charts"
    },
    {
      "id": "sample",
      "from": "chart_read",
      "to": "detector"
    },
    {
      "id": "suspect",
      "from": "detector",
      "to": "target_check",
      "label": "suspected freeze",
      "variant": "emphasis"
    },
    {
      "id": "verified",
      "from": "target_check",
      "to": "dumps",
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "from": "dumps",
      "to": "restart",
      "label": "also on save failure",
      "variant": "emphasis"
    },
    {
      "id": "ignore",
      "from": "detector",
      "to": "no_capture",
      "label": "predicate not met",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "write",
      "from": "dumps",
      "to": "captures",
      "label": "async save",
      "variant": "dashed"
    },
    {
      "id": "ring_save",
      "from": "ring",
      "to": "captures",
      "label": "raw events",
      "variant": "dashed"
    },
    {
      "id": "after_recovery",
      "from": "restart",
      "to": "analysis",
      "label": "after recovery",
      "variant": "emphasis"
    },
    {
      "id": "decode",
      "from": "captures",
      "to": "analysis",
      "label": "decode",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Candidates, not causal proof",
      "items": [
        "Full logical grid: 80% of widths within one adjacent pixel pair",
        "Boot auto-launch & off-page restore: SW_SHOWNOACTIVATE; 2 min off-page A8 backoff",
        "Idle floor corroboration: empty or <= 2 px charts require 0x8007139F or >= 3 px visible CPU",
        "Fast recovery & watchdog: 0x8007139F / 10 s; 15 s silence re-enables; gaps mark N2 indeterminate",
        "Visual fallback: 30 s stale total curve confirms unassisted freeze",
        "Dual circular ETW: Kernel-Process + Taskmgr Error (128 MB)",
        "Trigger path recorded: native_fast, visual, or both",
        "Data layer heartbeat: CurrentUpdateCycle (level 5 name-filtered)",
        "No debugger or dumps; independent phase ranks and controls"
      ]
    }
  ]
}
