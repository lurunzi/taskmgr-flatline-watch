{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Task Manager lightweight incident recording",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "Task Manager"
        },
        "backend": {
          "label": "Watcher step"
        },
        "security": {
          "label": "Guard"
        },
        "database": {
          "label": "Evidence"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "taskmgr",
      "label": "Task Manager"
    },
    {
      "id": "watcher",
      "label": "Watcher (tray, elevated)"
    },
    {
      "id": "guard",
      "label": "Guards",
      "variant": "exception"
    },
    {
      "id": "evidence",
      "label": "Evidence on D:"
    }
  ],
  "phases": [
    {
      "id": "observe",
      "label": "Observe",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "capture",
      "label": "Preserve incident",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "label": "Recover and analyse",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "cpu_page",
    "chart_read",
    "detector",
    "target_check",
    "dumps",
    "restart",
    "analysis"
  ],
  "nodes": [
    {
      "id": "cpu_page",
      "lane": "taskmgr",
      "col": 0,
      "type": "frontend",
      "label": "CPU page",
      "sublabel": "all logical cores",
      "width": 150
    },
    {
      "id": "chart_read",
      "lane": "watcher",
      "col": 1,
      "type": "backend",
      "label": "Chart read",
      "sublabel": "PrintWindow every 2 s",
      "width": 150
    },
    {
      "id": "detector",
      "lane": "watcher",
      "col": 2,
      "type": "backend",
      "label": "Confirm flatline",
      "sublabel": "30 s; cores move",
      "width": 150
    },
    {
      "id": "target_check",
      "lane": "watcher",
      "col": 3,
      "type": "backend",
      "label": "Save observations",
      "sublabel": "times and charts",
      "width": 150
    },
    {
      "id": "dumps",
      "lane": "watcher",
      "col": 4,
      "type": "backend",
      "label": "Save ETW",
      "sublabel": "wait at most 2 s",
      "width": 150
    },
    {
      "id": "restart",
      "lane": "taskmgr",
      "col": 5,
      "type": "backend",
      "label": "Restart + CPU",
      "sublabel": "verify target and restore",
      "width": 150
    },
    {
      "id": "no_capture",
      "lane": "guard",
      "col": 2,
      "type": "security",
      "label": "Keep observing",
      "sublabel": "static page: no trigger",
      "width": 150
    },
    {
      "id": "captures",
      "lane": "evidence",
      "col": 4,
      "type": "database",
      "label": "Incident evidence",
      "sublabel": "ETL, markers, charts",
      "width": 150
    },
    {
      "id": "ring",
      "lane": "evidence",
      "col": 0,
      "type": "database",
      "label": "Circular ETW",
      "sublabel": "process/thread events",
      "width": 150
    },
    {
      "id": "analysis",
      "lane": "evidence",
      "col": 5,
      "type": "backend",
      "label": "Offline candidates",
      "sublabel": "parents, counts, coverage",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "read",
      "from": "cpu_page",
      "to": "chart_read",
      "label": "native charts"
    },
    {
      "id": "sample",
      "from": "chart_read",
      "to": "detector"
    },
    {
      "id": "suspect",
      "from": "detector",
      "to": "target_check",
      "label": "suspected freeze",
      "variant": "emphasis"
    },
    {
      "id": "verified",
      "from": "target_check",
      "to": "dumps",
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "from": "dumps",
      "to": "restart",
      "label": "also on save failure",
      "variant": "emphasis"
    },
    {
      "id": "ignore",
      "from": "detector",
      "to": "no_capture",
      "label": "predicate not met",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "write",
      "from": "dumps",
      "to": "captures",
      "label": "async save",
      "variant": "dashed"
    },
    {
      "id": "ring_save",
      "from": "ring",
      "to": "captures",
      "label": "raw events",
      "variant": "dashed"
    },
    {
      "id": "after_recovery",
      "from": "restart",
      "to": "analysis",
      "label": "after recovery",
      "variant": "emphasis"
    },
    {
      "id": "decode",
      "from": "captures",
      "to": "analysis",
      "label": "decode",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Candidates, not causal proof",
      "items": [
        "Visual observations are not native fault times",
        "Missing required coverage or event loss suppresses named ranks",
        "No debugger or dumps; retain raw evidence"
      ]
    }
  ]
}
